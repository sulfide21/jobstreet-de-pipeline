# Python
.venv/
__pycache__/
*.pyc

# Warehouse — regenerated by pipeline/load_raw.py + dbt, never hand-edited
warehouse/*.duckdb
warehouse/*.duckdb.wal

# Scraped data — regenerated by jobstreet_scraper.py / the Airflow DAG
data_lake/
jobstreet_jobs.csv
jobstreet_jobs.json

# dbt export — regenerated by pipeline/export_marts.py
exports/*.parquet

# Airflow runtime (not the DAG code)
airflow/logs/
airflow/plugins/
airflow/.env
# auto-generated on first run; contains a real fernet/secret key, don't commit
airflow/config/airflow.cfg

# dbt runtime
transform/target/
transform/logs/
transform/dbt_packages/
transform/.user.yml

# DuckDB CLI binary (37MB, download it yourself — see README)
duckdb.exe

# OS / editor
.DS_Store
Thumbs.db
